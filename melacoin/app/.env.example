# Copy this file to .env and edit it. .env is git-ignored.
# Every line here is optional - the app runs with no .env at all.

PORT=4000
HOST=127.0.0.1
DB_PATH=./data/melacoin.db

# ---------------------------------------------------------------- the token
# "mock"  = no blockchain. MELA balances live in the database. Start here.
# "chain" = real blockchain. Needs `npm install ethers` and the values below.
CHAIN_MODE=mock

# Price of 1 MELA in paise. 100 = Rs 1.00. Admins can change this while running.
DEFAULT_MELA_PRICE_PAISE=100

# Only needed when CHAIN_MODE=chain. Fill these from `npm run deploy:local` in ../chain.
CHAIN_ID=31337
MELA_TOKEN_ADDRESS=
MELA_DISTRIBUTOR_ADDRESS=
VOUCHER_TTL_MINUTES=60

# The key that signs withdrawal vouchers. NEVER commit a real one.
# In production this belongs in a KMS or hardware signer, not in a file.
VOUCHER_SIGNER_PRIVATE_KEY=

# --------------------------------------------------------------- housekeeping
SESSION_TTL_HOURS=168
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_MAX=600
