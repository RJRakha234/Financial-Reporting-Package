# Copy to .env before deploying to a testnet or mainnet. .env is git-ignored.

# The account that pays gas for the deployment. Use a throwaway key for testnets.
DEPLOYER_PRIVATE_KEY=

# Who ends up holding DEFAULT_ADMIN_ROLE. On mainnet this MUST be a multisig
# (Safe: https://safe.global), never a single private key on a laptop.
ADMIN_ADDRESS=

# The backend key allowed to sign withdrawal vouchers. It holds no tokens.
VOUCHER_SIGNER_ADDRESS=

POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://polygon-rpc.com
