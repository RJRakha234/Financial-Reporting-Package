# Copy to .env and fill in. Load it before running the bot, e.g.:
#   set -a && source .env && set +a
# (.env is git-ignored — never commit real secrets.)

# --- Microsoft Graph backend ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- IMAP backend ---
IMAP_USERNAME=
IMAP_PASSWORD=

# --- Portal login ---
PORTAL_USERNAME=
PORTAL_PASSWORD=
