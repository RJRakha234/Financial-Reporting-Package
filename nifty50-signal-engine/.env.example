# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
#
# Zerodha Kite Connect (https://kite.trade). ~Rs 500/month per API key.
# Create an app at https://developers.kite.trade to get the key and secret.
KITE_API_KEY=
KITE_API_SECRET=

# Filled in automatically by the engine after each morning's login.
# Kite access tokens expire daily (~06:00 IST) and there is NO refresh token:
# the OAuth redirect must be walked by a human once per trading day.
KITE_ACCESS_TOKEN=

# Paste the `request_token` query parameter from the post-login redirect URL,
# then run any entry point. It is single-use and is cleared once consumed.
KITE_REQUEST_TOKEN=

# Optional: point at a non-default config file.
# NIFTY50_CONFIG=/path/to/config.yaml
