# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# IMPORTANT: this tool is ALERT-ONLY. It reads public market data and never
# places, cancels, or modifies an order — there is no code path that can (see
# the PUBLIC_PATHS allowlist in cse/data/rest.py).
#
# Every endpoint used is PUBLIC. You do not need an API key at all for the data
# layer. If you supply one anyway, it MUST be read-only ("Enable Reading" only,
# with trading and withdrawals DISABLED). Do not put a trading-enabled key here.

# Optional. Only raises your rate-limit tier; not required by any code path.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Alert channels (Phase 6) ------------------------------------------------
# Telegram: create a bot with @BotFather, then message it once to get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook (Slack/Discord/custom). Payload includes signal reasoning.
ALERT_WEBHOOK_URL=

# --- Overrides ---------------------------------------------------------------
# Path to an alternative config.yaml (used by docker-compose).
# CSE_CONFIG=/app/config.yaml
